{
    "name": "gh-aw-workshop",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build:docs": "node scripts/build-docs.js",
        "lint:md": "markdownlint-cli2 \"**/*.md\"",
        "test": "node --test scripts/build-docs.test.js && node --test scripts/check-svg-visual-language.test.js",
        "test:contrast": "playwright test --config=playwright.svg-contrast.config.js",
        "test:visual-language": "node --test scripts/check-svg-visual-language.test.js"
    },
    "devDependencies": {
        "@fontsource-variable/mona-sans": "^5.3.0",
        "@playwright/test": "^1.55.0",
        "@primer/css": "^21.0.8",
        "github-slugger": "^2.0.0",
        "highlight.js": "^11.11.1",
        "marked": "^15.0.12",
        "marked-alert": "^2.1.2",
        "marked-highlight": "^2.2.2",
        "markdownlint-cli2": "^0.18.1",
        "node-emoji": "^2.2.0"
    }
}
